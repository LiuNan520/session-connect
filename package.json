{
  "name": "session-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "imports": {
    "#shared": "./dist/shared/index.js"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/index.ts --mode dev\" \"vite --config vite.config.ts\"",
    "build": "vite build --config vite.config.ts && tsc -p shared/tsconfig.json && tsc -p server/tsconfig.build.json",
    "start": "npm run build && node dist/server/index.js --mode dev --open",
    "app": "node scripts/build-app.mjs",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "fixture": "node scripts/make-perf-fixture.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@xyflow/react": "^12.12.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
